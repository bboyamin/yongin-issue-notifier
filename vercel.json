{
  "version": 2,
  "functions": {
    "api/*.py": {
      "includeFiles": "public/data/**"
    }
  },
  "rewrites": [
    { "source": "/api/collect", "destination": "/api/collect.py" },
    { "source": "/api/papernews", "destination": "/api/papernews.py" },
    { "source": "/api/etnews", "destination": "/api/etnews.py" },
    { "source": "/api/mknews", "destination": "/api/mknews.py" }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Expires", "value": "0" }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    }
  ]
}
